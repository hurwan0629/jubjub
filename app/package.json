    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
