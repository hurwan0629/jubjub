# 이 파일을 .env 로 복사해서 써요 (.env 는 git에 올라가지 않아요).
# 비워 두면 목업 데이터(src/api/mock)로 화면이 떠요. 백엔드가 생기면 주소를 넣어요.
# 예) EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
EXPO_PUBLIC_API_URL=

# 네이버 지도 (NCP Maps) Client ID. 네이버 클라우드 콘솔 > Maps > Application > 인증 정보에서 확인해요.
# Client Secret은 여기에 넣지 마세요 (앱에 들어가면 안 돼요).
NAVER_MAP_CLIENT_ID=
