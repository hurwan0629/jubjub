# 이 파일을 복사해 .env 를 만들고 값 채우기

# Supabase
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 앱(Expo 웹)에서 호출을 허용할 주소
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)(:\d+)?$

# 로그인 토큰 서명 키
JWT_SECRET=

# 로봇 (rosbridge)
ROBOT_BRIDGE_URL=ws://192.168.0.10:9090
USE_SIMULATOR=true

# 사진 저장 폴더
PHOTO_DIR=./storage/photos

# 운영 에이전트 LLM
LLM_API_KEY=
LLM_MODEL=
