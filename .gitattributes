# Normalize line endings (team uses Windows; robot runs Linux on Jetson)
* text=auto

# Files executed on the robot must keep LF
*.sh   text eol=lf
*.py   text eol=lf
*.launch text eol=lf
*.xml  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.pt   binary
*.onnx binary
