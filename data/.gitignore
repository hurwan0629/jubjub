# data/ 에서는 라벨(json, txt)과 문서·설정 파일만 git에 올린다.
# 이미지와 그 밖의 파일은 용량이 커서 올리지 않는다.

# 1. 일단 모든 파일을 무시
*

# 2. 폴더 안까지는 들어가서 아래 규칙을 적용
!*/

# 3. 남길 파일
!*.json
!*.txt
!.gitignore
# 문서·설정·분석 코드 (README, data.yaml, data_schema.yaml, make_figures.py, 노트북)
!*.md
!*.yaml
!*.py
!*.ipynb
# 라이선스
!

# 스크립트가 만든 통계 결과 (README에 그림이 들어감)
!reports/tables/*.csv
!reports/figures/*.png

# 4. 남길 확장자여도 올리지 않는 것
# reports/previews/ 는 데이터셋 이미지 자체라서 올리지 않는다 (jpg 라 위 규칙으로 이미 제외됨)
__pycache__/
tmp/
.bbox_labeler/

# compose/ 의 txt 목록은 이 컴퓨터의 절대 경로가 들어 있고, build_compose.py 로 언제든 다시 만들 수 있다.
# yaml 과 README 만 올린다.
compose/*.txt

# 5. HOWA는 라벨도 올리지 않는다.
#    신청한 사람에게 비영리 연구·교육용으로만 제공되는 데이터라 라벨을 공개 저장소에 올리면 재배포가 된다.
#    팀원은 각자 신청해 받은 howa.zip으로 members/hur-wan/datasets/claude_data/scripts/convert_howa.py 를 실행한다.
howa_yolo/
howa_coco/
